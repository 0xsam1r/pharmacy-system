<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="gui.controllers.DashboardController" 
            styleClass="dashboard-container" 
            prefWidth="1400" prefHeight="900">
    
    <!-- Top Menu Bar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Logout" onAction="#handleLogout"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#handleAbout"/>
            </Menu>
        </MenuBar>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="0">
            <!-- Logo/Title -->
            <VBox alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #1a252f;">
                <Label text="PMS" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Pharmacy System" style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;"/>
            </VBox>
            
            <Separator style="-fx-background-color: #34495e;"/>
            
            <!-- Navigation Buttons -->
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" text="Dashboard" styleClass="sidebar-button, sidebar-button-active" 
                        prefWidth="220" onAction="#showDashboardView"/>
                <Button fx:id="btnProducts" text="Products" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showProductsView"/>
                <Button fx:id="btnInventory" text="Inventory" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showInventoryView"/>
                <Button fx:id="btnSales" text="Sales" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showSalesView"/>
                <Button fx:id="btnCustomers" text="Customers" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showCustomersView"/>
                <Button fx:id="btnEmployees" text="Employees" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showEmployeesView"/>
                <Button fx:id="btnReports" text="Reports" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showReportsView"/>
                <Button fx:id="btnSuppliers" text="Suppliers" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showSuppliersView"/>
                <Button fx:id="btnSettings" text="Settings" styleClass="sidebar-button" 
                        prefWidth="220" onAction="#showSettingsView"/>
            </VBox>
            
            <!-- User Info at Bottom -->
            <VBox style="-fx-padding: 15; -fx-background-color: #1a252f;" spacing="8">
                <Label fx:id="userLabel" text="Welcome, User" 
                       style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" wrapText="true" maxWidth="190"/>
                <Label fx:id="roleLabel" text="Role: Admin" 
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;" wrapText="true" maxWidth="190"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Dashboard Loaded (Simplified Version)" style="-fx-font-size: 24px;"/>
        </StackPane>
    </center>
</BorderPane>
