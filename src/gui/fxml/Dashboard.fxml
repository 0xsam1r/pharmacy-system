<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="gui.controllers.DashboardController" 
            styleClass="dashboard-container" 
            prefWidth="1400" prefHeight="900">
    
    <!-- Top Menu Bar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Logout" onAction="#handleLogout"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#handleAbout"/>
                <MenuItem text="Documentation"/>
            </Menu>
        </MenuBar>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="0">
            <!-- Logo/Title -->
            <VBox alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #1a252f;">
                <Label text="💊 PMS" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Pharmacy System" style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;"/>
            </VBox>
            
            <Separator style="-fx-background-color: #34495e;"/>
            
            <!-- Navigation Buttons -->
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" text="📊 Dashboard" styleClass="sidebar-button, sidebar-button-active" 
                        maxWidth="Infinity" onAction="#showDashboardView"/>
                <Button fx:id="btnProducts" text="💊 Products" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showProductsView"/>
                <Button fx:id="btnInventory" text="📦 Inventory" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showInventoryView"/>
                <Button fx:id="btnSales" text="🛒 Sales" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showSalesView"/>
                <Button fx:id="btnCustomers" text="👥 Customers" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showCustomersView"/>
                <Button fx:id="btnEmployees" text="👔 Employees" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showEmployeesView"/>
                <Button fx:id="btnReports" text="📈 Reports" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showReportsView"/>
                <Button fx:id="btnSettings" text="⚙️ Settings" styleClass="sidebar-button" 
                        maxWidth="Infinity" onAction="#showSettingsView"/>
            </VBox>
            
            <!-- User Info at Bottom -->
            <VBox style="-fx-padding: 15; -fx-background-color: #1a252f;" spacing="5">
                <Label fx:id="userLabel" text="👤 Welcome, User" 
                       style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label fx:id="roleLabel" text="Role: Admin" 
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <!-- Default Dashboard View -->
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                <VBox spacing="20">
                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Dashboard Overview" styleClass="label-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dateTimeLabel" text="🕒 Loading..." 
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                    </HBox>
                    
                    <!-- Statistics Cards -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>
                        
                        <!-- Total Sales Card -->
                        <VBox styleClass="stat-card" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);" 
                              GridPane.columnIndex="0">
                            <Label text="💰" style="-fx-font-size: 32px;"/>
                            <Label fx:id="totalSalesLabel" text="$0" styleClass="stat-value" 
                                   style="-fx-text-fill: white;"/>
                            <Label text="Total Sales Today" styleClass="stat-label" 
                                   style="-fx-text-fill: rgba(255,255,255,0.8);"/>
                        </VBox>
                        
                        <!-- Total Products Card -->
                        <VBox styleClass="stat-card" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #f093fb, #f5576c);" 
                              GridPane.columnIndex="1">
                            <Label text="📦" style="-fx-font-size: 32px;"/>
                            <Label fx:id="totalProductsLabel" text="0" styleClass="stat-value" 
                                   style="-fx-text-fill: white;"/>
                            <Label text="Products in Stock" styleClass="stat-label" 
                                   style="-fx-text-fill: rgba(255,255,255,0.8);"/>
                        </VBox>
                        
                        <!-- Low Stock Alert Card -->
                        <VBox styleClass="stat-card" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #fa709a, #fee140);" 
                              GridPane.columnIndex="2">
                            <Label text="⚠️" style="-fx-font-size: 32px;"/>
                            <Label fx:id="lowStockLabel" text="0" styleClass="stat-value" 
                                   style="-fx-text-fill: white;"/>
                            <Label text="Low Stock Items" styleClass="stat-label" 
                                   style="-fx-text-fill: rgba(255,255,255,0.8);"/>
                        </VBox>
                        
                        <!-- Total Customers Card -->
                        <VBox styleClass="stat-card" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #30cfd0, #330867);" 
                              GridPane.columnIndex="3">
                            <Label text="👥" style="-fx-font-size: 32px;"/>
                            <Label fx:id="totalCustomersLabel" text="0" styleClass="stat-value" 
                                   style="-fx-text-fill: white;"/>
                            <Label text="Total Customers" styleClass="stat-label" 
                                   style="-fx-text-fill: rgba(255,255,255,0.8);"/>
                        </VBox>
                    </GridPane>
                    
                    <!-- Recent Transactions Table -->
                    <VBox styleClass="card" spacing="15">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent Transactions" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="View All" styleClass="btn, btn-secondary" onAction="#showAllTransactions"/>
                        </HBox>
                        
                        <TableView fx:id="recentTransactionsTable" prefHeight="300">
                            <columns>
                                <TableColumn text="Invoice ID" prefWidth="100" fx:id="colInvoiceId"/>
                                <TableColumn text="Date" prefWidth="150" fx:id="colDate"/>
                                <TableColumn text="Customer" prefWidth="200" fx:id="colCustomer"/>
                                <TableColumn text="Items" prefWidth="100" fx:id="colItems"/>
                                <TableColumn text="Total" prefWidth="120" fx:id="colTotal"/>
                                <TableColumn text="Status" prefWidth="120" fx:id="colStatus"/>
                            </columns>
                        </TableView>
                    </VBox>
                    
                    <!-- Quick Actions and Alerts -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        
                        <!-- Quick Actions -->
                        <VBox styleClass="card" spacing="15" GridPane.columnIndex="0">
                            <Label text="Quick Actions" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <VBox spacing="10">
                                <Button text="➕ New Sale" styleClass="btn, btn-success" 
                                        maxWidth="Infinity" onAction="#createNewSale"/>
                                <Button text="📦 Add Product" styleClass="btn, btn-primary" 
                                        maxWidth="Infinity" onAction="#addNewProduct"/>
                                <Button text="👤 Add Customer" styleClass="btn, btn-primary" 
                                        maxWidth="Infinity" onAction="#addNewCustomer"/>
                                <Button text="📊 Generate Report" styleClass="btn, btn-secondary" 
                                        maxWidth="Infinity" onAction="#generateReport"/>
                            </VBox>
                        </VBox>
                        
                        <!-- System Alerts -->
                        <VBox styleClass="card" spacing="15" GridPane.columnIndex="1">
                            <Label text="System Alerts" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <ListView fx:id="alertsList" prefHeight="200"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
