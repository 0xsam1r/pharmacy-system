<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      spacing="20" style="-fx-background-color: transparent;" alignment="CENTER">
    
    <VBox styleClass="card" spacing="20" alignment="CENTER" maxWidth="600">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
        
        <Label text="⚙️" style="-fx-font-size: 64px;"/>
        <Label text="Settings" styleClass="label-header"/>
        <Label text="This feature is under development" style="-fx-text-fill: #7f8c8d;"/>
        
        <Separator prefWidth="400"/>
        
        <Label text="Coming soon:" style="-fx-font-weight: bold;"/>
        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="✓ Database configuration"/>
            <Label text="✓ User preferences"/>
            <Label text="✓ Backup and restore"/>
            <Label text="✓ System maintenance"/>
            <Label text="✓ Notification settings"/>
        </VBox>
    </VBox>
</VBox>
