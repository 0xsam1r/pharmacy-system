<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="gui.controllers.EmployeesController" 
      spacing="20" style="-fx-background-color: transparent;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Employees Management" styleClass="label-header"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Add New Employee" styleClass="btn, btn-success" onAction="#handleAddEmployee"/>
    </HBox>
    
    
    <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        
        <Label text="🔍 Search:"/>
        <TextField fx:id="searchField" promptText="Search by name, ID or phone..." prefWidth="300" 
                   onKeyReleased="#handleSearch"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button text="🔄 Refresh" styleClass="btn, btn-secondary" onAction="#handleRefresh"/>
    </HBox>
    
    
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT">
            <Label text="Employees List" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="employeeCountLabel" text="Total: 0 employees" style="-fx-text-fill: #7f8c8d;"/>
        </HBox>
        
        <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ID" prefWidth="100" fx:id="colId"/>
                <TableColumn text="Name" prefWidth="200" fx:id="colName"/>
                <TableColumn text="Phone" prefWidth="120" fx:id="colPhone"/>
                <TableColumn text="Username" prefWidth="150" fx:id="colUsername"/>
                <TableColumn text="Role" prefWidth="120" fx:id="colRole"/>
                <TableColumn text="Salary ($)" prefWidth="100" fx:id="colSalary"/>
                <TableColumn text="Start Date" prefWidth="120" fx:id="colStartDate"/>
                <TableColumn text="Actions" prefWidth="200" fx:id="colActions"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
