<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
           fx:controller="gui.controllers.LoginController" 
           styleClass="login-container" 
           prefWidth="1000" prefHeight="700">
    
    <VBox alignment="CENTER" spacing="0">
        <VBox styleClass="login-box" alignment="CENTER" spacing="25" maxWidth="450" maxHeight="550">
            
            
            <VBox alignment="CENTER" spacing="8">
                <Label text="💊" style="-fx-font-size: 48px;"/>
                <Label text="Pharmacy Management System" styleClass="login-title"/>
                <Label text="Welcome back! Please login to your account." styleClass="login-subtitle"/>
            </VBox>
            
            
            <VBox spacing="8">
                <Label text="Username" style="-fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Enter your username" prefWidth="350"/>
            </VBox>
            
            
            <VBox spacing="8">
                <Label text="Password" style="-fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" prefWidth="350"/>
            </VBox>
            
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <CheckBox fx:id="rememberMeCheckbox" text="Remember me"/>
            </HBox>
            
            
            <Label fx:id="errorLabel" textFill="red" wrapText="true" visible="false" 
                   style="-fx-font-size: 12px; -fx-padding: 5;"/>
            
            
            <Button fx:id="loginButton" text="Login" styleClass="btn, btn-primary" 
                    prefWidth="350" onAction="#handleLogin" defaultButton="true"/>
            
            
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword" 
                          style="-fx-text-fill: #667eea;"/>
            </HBox>
            
            <VBox.margin>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </VBox.margin>
        </VBox>
        
        
        <Label text="Version 1.0" style="-fx-text-fill: white; -fx-opacity: 0.7; -fx-padding: 20;" 
               StackPane.alignment="BOTTOM_RIGHT"/>
    </VBox>
</StackPane>
